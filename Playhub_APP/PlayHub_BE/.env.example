APP_NAME=Play Hub API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./playhub.db
# Production example: postgresql+psycopg://playhub:password@localhost:5432/playhub
JWT_SECRET=development-only-secret-change-before-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=playhub-api
JWT_AUDIENCE=playhub-web
FRONTEND_BASE_URL=http://localhost:3000
ENABLE_TEST_PERSONAS=true
UPLOAD_MAX_MEGABYTES=100
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Google Identity Services (same Web client ID in the frontend VITE_GOOGLE_CLIENT_ID).
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Sign in with Apple: the Services ID (same value as VITE_APPLE_CLIENT_ID).
# APPLE_CLIENT_ID=com.thetoypharmacy.playhub.web
# Sign in with Microsoft: Application (client) ID of the Azure app (same as VITE_MICROSOFT_CLIENT_ID).
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Stripe Checkout. Use Stripe test-mode secrets in development.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Local filesystem object store. It uses the same object keys/API responses as S3.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_LOCAL_URL_PREFIX=/uploads
STORAGE_KEY_PREFIX=media

# Production S3/CloudFront example. Prefer an IAM role instead of static AWS keys.
# For a complete development profile, see .env.s3.example. Switching requires
# STORAGE_BACKEND=s3; credentials alone never silently change the backend.
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=playhub-production-media
# S3_REGION=ap-south-1
# STORAGE_PUBLIC_BASE_URL=https://media.example.com
# S3_SERVER_SIDE_ENCRYPTION=AES256
# For KMS: S3_SERVER_SIDE_ENCRYPTION=aws:kms and S3_KMS_KEY_ID=<key ARN>
# S3_ENDPOINT_URL is optional and intended for MinIO/LocalStack only.
