# Copy this file to .env to run the API against an S3-compatible bucket in development.
# The storage driver changes only when STORAGE_BACKEND is explicitly set to s3.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./playhub.db
JWT_SECRET=development-only-secret-change-before-production-32chars
ENABLE_TEST_PERSONAS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
FRONTEND_BASE_URL=http://localhost:3000

STORAGE_BACKEND=s3
STORAGE_KEY_PREFIX=media
UPLOAD_MAX_MEGABYTES=100
S3_BUCKET_NAME=playhub-development-media
S3_REGION=ap-south-1
STORAGE_PUBLIC_BASE_URL=https://playhub-development-media.s3.ap-south-1.amazonaws.com
S3_SERVER_SIDE_ENCRYPTION=AES256

# For local MinIO/LocalStack only:
# S3_ENDPOINT_URL=http://localhost:9000
# STORAGE_PUBLIC_BASE_URL=http://localhost:9000/playhub-development-media

# boto3 reads credentials from the standard AWS provider chain. For local-only
# static credentials, set these in your uncommitted .env. In hosted environments,
# leave them unset and use an IAM role instead.
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=replace-me-if-needed
