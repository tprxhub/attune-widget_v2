VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Sign in with Apple: the Services ID. The redirect URI must be a Return URL on that Services ID.
# VITE_APPLE_CLIENT_ID=com.thetoypharmacy.playhub.web
# VITE_APPLE_REDIRECT_URI=https://your-domain/login
# Sign in with Microsoft: Application (client) ID. Add https://your-domain/auth/microsoft-callback
# as a "Single-page application" redirect URI in Azure.
# VITE_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Development only. Requires ENABLE_TEST_PERSONAS=true on the API and a seeded tester login.
VITE_ENABLE_PERSONA_SWITCHER=false
# Browser developer tools are blocked in production builds. This is a deterrent, not a security
# control: access to data is enforced by the API.
# VITE_ALLOW_DEVTOOLS=true            # switch the block off, for example on a staging site
# VITE_ENABLE_DEVTOOLS_GUARD=true     # switch it on in `vite dev` to try it locally
